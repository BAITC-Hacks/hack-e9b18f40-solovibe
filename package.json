{
  "name": "solovibe-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node runtime/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src runtime next.config.ts drizzle.config.ts eslint.config.mjs postcss.config.mjs",
    "check": "pnpm typecheck && pnpm lint",
    "test:domain": "tsx --test src/features/city/__tests__/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx runtime/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "infra:up": "docker compose up -d db",
    "infra:stop": "docker compose stop db",
    "local:up": "docker compose build app && docker compose up -d --wait --wait-timeout 120 db && docker compose run -T --rm --no-deps migrate && docker compose up -d --no-deps --no-build --wait --wait-timeout 120 app",
    "local:stop": "docker compose stop",
    "env:init": "node runtime/setup.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.63",
    "@ai-sdk/react": "4.0.98",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@fontsource-variable/onest": "^5.3.1",
    "ai": "7.0.95",
    "better-auth": "1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.43.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
